# Dependencies and build output
node_modules/
dist/
coverage/

# Engine build output (generated, see docs/ENGINE-BUILD.md)
engine/build/
engine/.cache/
app/public/engine/

# ffmpeg.wasm core copied from node_modules by app/scripts/sync-ffmpeg.mjs
app/public/ffmpeg/

# Local files
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Backups the app makes of an iPod's database files. They hold the device's ID and the library, so they must never be committed.
opentunes-backup-*/
ipod-backups/

# Checkouts the build tooling makes for parallel work
.claude/
